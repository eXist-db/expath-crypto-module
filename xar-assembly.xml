<?xml version="1.0" encoding="UTF-8"?>
<package xmlns="http://expath.org/ns/pkg"
         name="${package-name}"
         abbrev="${package-abbrev}"
         version="${project.version}"
         spec="1.0">
    <title>${project.name}</title>
    <description>${project.description}</description>
    <author id="exist-db">${project.organization.name}</author>
    <website>${project.url}</website>
    <license>GNU Lesser General Public License, version 2.1</license>
    <copyright>true</copyright>

    <type>library</type>

    <status>stable</status>

    <tag>${project.artifactId}</tag>
    <tag>crypto</tag>
    <tag>hmac</tag>
    <tag>encryption</tag>
    <tag>xml-signature</tag>
    <tag>expath</tag>
    <category id="libs">Libraries</category>

    <dependency processor="http://exist-db.org" semver-min="6.2.0"/>

    <target>${package-abbrev}</target>

    <fileSets>
        <fileSet>
            <directory>${basedir}</directory>
            <includes>
                <include>README.md</include>
                <include>LICENSE</include>
            </includes>
        </fileSet>
    </fileSets>

    <!-- include the Java module JAR from this project -->
    <dependencySets>
        <dependencySet>
            <groupId>${project.groupId}</groupId>
            <artifactId>${project.artifactId}</artifactId>
            <version>${project.version}</version>
        </dependencySet>
    </dependencySets>

    <!-- register the Java module to eXist-db -->
    <components>
        <resource>
            <public-uri>${crypto.module.namespace}</public-uri>
            <file>urn:java:class:${crypto.module.java.classname}</file>
        </resource>
    </components>

    <changelog>
        <change xmlns="http://exist-db.org/xquery/repo" version="7.0.0">
            <ul xmlns="http://www.w3.org/1999/xhtml">
                <li>Complete rewrite using Java JCE (no external dependencies)</li>
                <li>Drop-in replacement for expath-crypto-module 6.x</li>
                <li>All old arities preserved for backward compatibility</li>
                <li>Binary input support for crypto:hmac</li>
                <li>BaseX-compatible function signatures</li>
                <li>102 tests (JUnit + XQSuite)</li>
                <li>Requires Java 17+ and eXist-db 7.0+</li>
            </ul>
        </change>
    </changelog>
</package>
